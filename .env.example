# This file will contain all the environment variables that are required for the application to run.
# `make setup` copies it to .env. In Docker, infra.dx sets these instead.

AIAPI_API_KEY=<Any custom key that is to be passed as a header to any call>

AIAPI_OPENAI_API_KEY=<Your openAI API Key>

# For DX: dx.backend's parsed-data-files folder. The default works when the DX
# repos sit side by side (see infra.dx); in Docker it's /parsed-data-files/.
AIAPI_PARSED_DATA_FILES=../dx.backend/parsed-data-files/

FLASK_DEBUG=True # False for production
